{
  "name": "carbon-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Carbon — a local-first Markdown writing app for Windows with bring-your-own AI.",
  "license": "MIT",
  "author": "Yajat Dayal",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyitsyajat/carbon.git"
  },
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "test": "npm --prefix app run test",
    "lint": "npm --prefix app run lint",
    "typecheck": "npm --prefix app run typecheck",
    "format": "npm --prefix app run format",
    "dist": "npm --prefix app run dist",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "install:all": "npm install && npm --prefix app install && npm --prefix website install"
  }
}
